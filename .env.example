# PostgreSQL server URL without a database name; Out connects to /out-auth and /out-data separately.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Qloo recommendations (server-side only)
QLOO_API_KEY=
# Optional: defaults to https://api.qloo.com; use the API origin supplied with your key.
# For a Qloo hackathon key, use https://hackathon.api.qloo.com when instructed by Qloo.
# QLOO_BASE_URL=https://api.qloo.com
