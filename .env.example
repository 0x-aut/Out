# PostgreSQL server URL without a database name; Out connects to /out-auth and /out-data separately.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Qloo recommendations (server-side only)
QLOO_API_KEY=
# Optional: defaults to the Qloo hackathon API. For a standard production key, use https://api.qloo.com.
# QLOO_BASE_URL=https://hackathon.api.qloo.com
